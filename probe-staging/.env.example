# Copy to .env and fill in. .env is gitignored — never commit keys.
OPENAI_API_KEY=sk-...
# Any model that supports the web_search tool on the Responses API.
OPENAI_MODEL=gpt-4o-mini
# Shared crew passcode for the web page.
PROBE_PASSCODE=change-me
# Accident brake: max runs per calendar day.
DAILY_RUN_LIMIT=50
# Samples per run. Baselines lock this; don't change mid-engagement.
SAMPLES_PER_RUN=10
